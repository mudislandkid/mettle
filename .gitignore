# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/
*.whl

# Virtualenvs (any common layout)
venv/
.venv/
env/
ENV/
*/venv/
*/.venv/

# Test / coverage / type-check / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.nox/

# Jupyter
.ipynb_checkpoints/

# --- Node / frontend ---
node_modules/
*.local
web/frontend/dist/
web/frontend/.vite/

# --- Databases ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Project-mapper MCP cache (external tooling) ---
.project-mapper.db*

# --- CodeCounter app state ---
analysis/
.code_counter_history
.analyzer_cache.json
**/.analyzer_cache.json
# Web UI SQLite database lives at web/codecounter.db (also covered by *.db above).
web/codecounter.db*
# Per-file mtime cache (normally lives under ~/.cache/code_counter/ but be safe).
file_cache.sqlite3*

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon?

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Claude Code per-machine settings ---
.claude/settings.local.json

# --- Git worktrees ---
.worktrees/

# --- Internal planning artefacts (brainstorming, specs, plans) ---
# Design docs, brainstorming output, and implementation plans live here.
# Kept local, never published.
docs/superpowers/

# Existing docs that are internal-only (audit + enhancement backlog).
# Will be deleted before public 0.9 launch, but ignored in the meantime
# so they aren't accidentally staged.
docs/CODEBASE_REVIEW.md
docs/ENHANCEMENTS.md
docs/reports/

# --- Backup / temp scratch files ---
*.bak
*.tmp
*.orig

# --- Cursor (per-workspace ignore) ---
# `.cursorignore` is editor-only metadata — keep out of history.
.cursorignore

# Phase D design hand-off archive (Claude Design output)
docs/design/
# Tauri updater signing key — NEVER commit.
.tauri-updater
.tauri-updater.pub.bak

# Tauri build artefacts
web/frontend/src-tauri/target/
web/frontend/src-tauri/gen/
web/frontend/src-tauri/binaries/mettle-sidecar*
# The repo-wide `Icon?` rule (macOS Finder metadata) accidentally matches
# our packaged app icons on case-insensitive filesystems — un-ignore them.
!web/frontend/src-tauri/icons/
!web/frontend/src-tauri/icons/**

# Sidecar build outputs
web/dist-sidecar/
web/build-sidecar/
*.spec.bak
