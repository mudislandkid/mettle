{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mettle",
  "version": "0.9.0",
  "identifier": "com.icepointlabs.mettle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mettle",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/mettle-sidecar"],
    "category": "DeveloperTool",
    "shortDescription": "Triage dashboard for the AI-coding era",
    "longDescription": "Honest line counts, health scoring, and cross-project insight for solo developers managing repo sprawl.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/mudislandkid/mettle/release-manifest/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCMUQwMzI5ODBEREU4QTQKUldTazZOMkFLUU1kbTU4ZTJmb2VaNUloWWszK21TV1diMGpQMUwwN0VvUnNaZEF2NkJobVRadTYK"
    }
  }
}
